# MewHelp Environment Configuration

# Chat Model Configuration (OpenAI Compatible)
CHAT_BASE_URL=https://your-model-gateway.example/v1
CHAT_MODEL=gemini-3.5-flash-lite
CHAT_API_KEY=test-token
# 忠实度裁判模型；留空或删除则沿用 CHAT_MODEL。
# 显式指定一个不同模型可避免生成与评判同一模型带来的自评偏差。
JUDGE_MODEL=
# 兼容旧配置 CHAT_TOKEN_BUDGET；同时存在时优先使用 TOKEN_BUDGET。
# 对话消息估算预算，包含当前问题和工具事实；不含系统提示和工具定义。
TOKEN_BUDGET=12000
# 完整模型输入估算预算，另计系统提示与决策阶段工具定义；不含模型输出。
REQUEST_TOKEN_BUDGET=16000

# 本章 Docker MySQL：将两个占位值分别替换为本地密码，勿提交真实 .env。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=mewhelp
MYSQL_TEST_DATABASE=mewhelp_test
MYSQL_USER=mewhelp
MYSQL_PASSWORD=replace-with-local-app-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
TOOL_TIMEOUT_SECONDS=5
TOOL_MAX_RETRIES=1
TOOL_RETRY_DELAY_SECONDS=0.2
# 同一条用户消息内允许连续调用工具；默认4次，允许1至8次。
TOOL_MAX_CALLS_PER_TURN=4

# CH03 知识库：本地 BGE-M3 + Milvus + MySQL；已验证版本组合见 docs/ch03-runbook.md。
# 模型从本地目录加载，不在服务请求中自动下载。
KNOWLEDGE_MODEL_PATH=models/bge-m3
MILVUS_URI=http://127.0.0.1:19530
MILVUS_DATABASE=mewhelp_ch03
MILVUS_COLLECTION=knowledge
# 本地 Milvus 无鉴权时留空；不要提交真实令牌。
MILVUS_TOKEN=
KNOWLEDGE_TEST_DATABASE=mewhelp_ch03_test
MILVUS_TEST_DATABASE=mewhelp_ch03_test
KNOWLEDGE_POLICY_PATH=data/knowledge/retrieval-policy.json
KNOWLEDGE_RELATION_POLICY_PATH=data/knowledge/relation-policy.json

# CH04 原生 BM25/RRF：独立新集合，不删除原 knowledge；先显式运行 prepare-hybrid。
KNOWLEDGE_RETRIEVAL_MODE=hybrid
MILVUS_HYBRID_COLLECTION=knowledge_ch04
RECALL_TOP_K=50
RERANK_TOP_K=10
SUBQUERY_SPLIT=true
# 阈值只作用于最高 sigmoid 重排分，不用于 COSINE/RRF，不是正确概率。
RERANK_MIN_SCORE=0.3
# 参考 CH09 默认值；当前未定义四信号/权重，未接入且不声称已校准。
EVIDENCE_CONFIDENCE_THRESHOLD=0.26
RERANK_MODEL_PATH=models/bge-reranker-large
RERANK_DEVICE=cuda:0
RERANK_BATCH_SIZE=4
KNOWLEDGE_TIMEOUT_SECONDS=60
KNOWLEDGE_RAG_TEST_DATABASE=mewhelp_ch04_test
MILVUS_RAG_TEST_DATABASE=mewhelp_ch04_test
# 切分固定文档入口默认：400 字符、60 完整句重叠、10 数据行；不提供环境变量。

# Reserved Embedding Model Configuration
EMBED_BASE_URL=
EMBED_MODEL=
EMBED_API_KEY=

# Reserved Rerank Model Configuration
RERANK_BASE_URL=
RERANK_MODEL=
RERANK_API_KEY=
