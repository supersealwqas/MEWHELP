# 复制为 .env.langfuse；每个秘密分别用 secrets.token_hex(32) 生成，勿沿用示例值。
POSTGRES_PASSWORD=replace-with-random-hex
CLICKHOUSE_PASSWORD=replace-with-random-hex
REDIS_AUTH=replace-with-random-hex
MINIO_ROOT_PASSWORD=replace-with-random-hex
SALT=replace-with-random-hex
# 运行本地观测服务前，填写本机生成的 64 位十六进制随机值。
ENCRYPTION_KEY=
NEXTAUTH_SECRET=replace-with-random-hex
LANGFUSE_PUBLIC_KEY=pk-lf-replace-with-random-hex
LANGFUSE_SECRET_KEY=sk-lf-replace-with-random-hex
LANGFUSE_INIT_USER_EMAIL=admin@mewhelp.local
LANGFUSE_INIT_USER_PASSWORD=replace-with-random-password
# 从官方镜像manifest核验并填入sha256摘要；验收不使用latest。
MINIO_IMAGE_DIGEST=sha256:3b6e40c30ecd5cea627e382ff0b82ca841f58c52294578787043ee80c8ef7c82
