  {
    "id": "D04",
    "mandatory": true,
    "title": "当前新号优先以及多个订单不猜测",
    "user_id": "demo-user",
    "turns": [
      {
        "id": "D04-T1",
        "query": "请确认订单1001现在是什么订单状态。",
        "expected": {
          "intent": "订单",
          "order_id": "1001",
          "preserve_raw": true
        }
      },
      {
        "id": "D04-T2",
        "query": "改查订单1002的商品总价，不查1001了。",
        "expected": {
          "intent": "订单",
          "order_id": "1002",
          "preserve_raw": true,
          "needs_resolution": false,
          "order_selection_reason": "当前明确选择1002，1001仅为被否定对象"
        }
      },
      {
        "id": "D04-T3",
        "query": "这笔想办理退货的话可以吗？",
        "expected": {
          "intent": "退款退货",
          "order_id": "1002",
          "preserve_raw": false,
          "needs_resolution": true,
          "resolved_contains": [
            "1002"
          ],
          "resolved_any": [
            "退货",
            "退"
          ],
          "forbidden_order_ids": [
            "1001"
          ]
        }
      },
      {
        "id": "D04-T4",
        "query": "订单1001和1002我都买过猫粮，这个我想退掉。",
        "expected": {
          "intent": "退款退货",
          "order_id": null,
          "preserve_raw": true,
          "needs_resolution": false,
          "preserve_semantics": [
            "两个候选均存在，未明确指向其中一个"
          ]
        },
        "workflow": {
          "expected_terminal": "awaiting_input",
          "select_order": true
        },
        "selection": {
          "order_id": "1002",
          "same_turn": true,
          "same_thread": true,
          "no_reclassification": true
        }
      },
      {
        "id": "D04-T5",
        "query": "先不继续退货，我现在只想看订单1001的订单金额。",
        "expected": {
          "intent": "订单",
          "order_id": "1001",
          "preserve_raw": true,
          "forbidden_order_ids": [
            "1002"
          ]
        }
      }
    ]
