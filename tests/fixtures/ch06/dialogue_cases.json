[
  {
    "id": "D01",
    "mandatory": true,
    "title": "物流、退款、物流连续切换",
    "user_id": "demo-user",
    "turns": [
      {
        "id": "D01-T1",
        "query": "我想知道订单1001的包裹目前送到哪里。",
        "expected": {
          "intent": "物流",
          "order_id": "1001",
          "preserve_raw": true
        }
      },
      {
        "id": "D01-T2",
        "query": "这笔订单里的猫粮不想要了，还能退吗？",
        "expected": {
          "intent": "退款退货",
          "order_id": "1001",
          "preserve_raw": false,
          "needs_resolution": true,
          "resolved_contains": [
            "1001"
          ],
          "resolved_any": [
            "退货",
            "退款",
            "退"
          ]
        },
        "workflow": {
          "query_count": 3,
          "order_before_policy": true,
          "ask_refund_reason": false
        }
      },
      {
        "id": "D01-T3",
        "query": "退款先放一下，我还是想查刚才那笔的配送进度。",
        "expected": {
          "intent": "物流",
          "order_id": "1001",
          "preserve_raw": false,
          "needs_resolution": true,
          "resolved_contains": [
            "1001"
          ],
          "resolved_any": [
            "物流",
            "配送",
            "运输"
          ]
        }
      },
      {
        "id": "D01-T4",
        "query": "现在改看订单1002的商品明细。",
        "expected": {
          "intent": "订单",
          "order_id": "1002",
          "preserve_raw": true,
          "forbidden_order_ids": [
            "1001"
          ]
        }
      },
      {
        "id": "D01-T5",
        "query": "查完了，谢谢你的帮助。",
        "expected": {
          "intent": "闲聊",
          "order_id": null,
          "preserve_raw": true
        }
      }
    ]
  },
