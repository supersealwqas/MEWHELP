# Environment & secrets
.env
.venv/
.data/checkpoints/
*.sqlite3-wal
*.sqlite3-shm
__pycache__/
*.pyc

# Pi / Agent 第三方技能缓存
.pi/git/
.pi/npm/
.agents/skills/superpowers/

# Testing & build
.pytest_cache/
.coverage
htmlcov/
dist/
build/

# pytest 临时根目录；除固定 /.pytest-tmp/ 外，验证过程会产生带后缀的变体
# （如 .pytest-tmp-verify、.pytest-tmp-citations-red），一律不入库
.pytest-tmp*/

# 代理与验证过程的临时工作目录（日志、探针、一次性 diff），9MB 级且可重建
/.tmp/

# 可视化 brainstorm 的临时示意、进程记录与本地访问密钥，不入库
/.superpowers/brainstorm/

# 评估/真实运行产物目录（reports/ 下逐次运行的 cases.jsonl、summary 等）
# 只保留生成规则与文档；结果按运行时间戳产生，不入库
/reports/

# 本地学习文档、示例与 Notebook；开发文档 docs/、dev-notes/ 仍正常跟踪
/mydemo/
/learning-guide/
*.ipynb
.ipynb_checkpoints/

# 本地模型权重（约 11GB，不入库；app/models/ 为业务代码不受影响）
/models/

# 知识库运行时缓存；manifest 与校准策略仍需正常跟踪
/data/knowledge/cache/
/.pytest-tmp/
